# Copia este archivo como .env y completa los valores.
# Supabase Session Pooler (host:5432)
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password

# API de Supabase (opcional para este backend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE=

# Django
DJANGO_SECRET_KEY=django-insecure-change-for-poc
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# URLs públicas
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://SERVER_IP:8000

# Gemini (opcional)
GEMINI_API_KEY=

# Email / SendGrid (opcional para ejecutar la API)
USE_ANYMAIL=False
EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL="Bovion <no-reply@example.com>"

# OneSignal (opcional)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
